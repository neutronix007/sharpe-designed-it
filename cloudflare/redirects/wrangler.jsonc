{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cliffordsharpe-redirects",
  "account_id": "2acf21efe206c3073f373c2e257ccd65", // Clifford's own account (needed now that wrangler also sees client accounts)
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "www.cliffordsharpe.com", "custom_domain": true },
    { "pattern": "agency.cliffordsharpe.com", "custom_domain": true }
  ]
}
