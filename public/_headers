# Media files keep their names between deploys, so cache them for a day (and let the browser
# reuse a copy for a week while it checks for a newer one). Without this, looping videos were
# downloaded again on every loop.
/*.mp4
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/*
  Cache-Control: public, max-age=31536000, immutable
